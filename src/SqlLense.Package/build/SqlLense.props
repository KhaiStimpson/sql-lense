<Project>
  <!-- Surface SqlLense settings to the analyzer (build_property.*). -->
  <ItemGroup>
    <CompilerVisibleProperty Include="SqlLenseEnabled" />
    <CompilerVisibleProperty Include="SqlLenseSchemaPath" />
    <CompilerVisibleProperty Include="SqlLenseDatabase" />
    <CompilerVisibleProperty Include="SqlLenseAnalyzeTests" />
    <CompilerVisibleProperty Include="IsTestProject" />
    <CompilerVisibleProperty Include="SolutionDir" />
  </ItemGroup>
</Project>
